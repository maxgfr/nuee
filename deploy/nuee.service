# Nuée anchor as a hardened systemd service.
#
#   install -m 0755 nuee /usr/local/bin/nuee
#   install -m 0644 deploy/nuee.service /etc/systemd/system/nuee.service
#   install -d -m 0755 /etc/nuee
#   printf 'NUEE_HOSTNAME=anchor.example.org\nNUEE_ACME_CONTACT=ops@example.org\n' > /etc/nuee/anchor.env
#   systemctl daemon-reload && systemctl enable --now nuee
#
# The anchor link (it carries the admin secret) is in the journal: journalctl -u nuee.
[Unit]
Description=Nuée anchor (persistent coordinator, relay, durable store, gateway)
Documentation=https://github.com/maxgfr/nuee/blob/main/docs/ANCHOR.md
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/nuee/anchor.env
ExecStart=/usr/local/bin/nuee serve --anchor \
    --relay-hostname ${NUEE_HOSTNAME} --acme-contact ${NUEE_ACME_CONTACT} \
    --store 10GiB --gateway 0.0.0.0:8080
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
KillSignal=SIGTERM

DynamicUser=yes
StateDirectory=nuee
StateDirectoryMode=0700
ConfigurationDirectory=nuee
# The identity key and the admin secret are written by the service itself, so the config
# directory of nuee lives in the state directory (writable by the dynamic user); /etc/nuee
# (%E/nuee) holds what the operator provides: anchor.env, an --allow-file, a relay token.
Environment=NUEE_DATA_DIR=%S/nuee NUEE_CONFIG_DIR=%S/nuee/config HOME=%S/nuee NUEE_LOG=info

ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
UMask=0077
# No MemoryDenyWriteExecute=yes: wasmtime compiles task modules to native code at run time
# and needs writable then executable memory.

[Install]
WantedBy=multi-user.target
